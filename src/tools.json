[
  {
    "name": "inspect_project",
    "description": "Read the live project, asset and clip IDs, timeline timing, selection and edit revision.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "import_media",
    "description": "Import a local video, image or audio file into the open media library. Returns its asset ID.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute Windows media file path."
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "edit_timeline",
    "description": "Apply edits together as one undo step. Source trims and fades use seconds. Move and insert indices are zero-based. Set soundtrack asset to null to clear it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "project"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ratio": {
                    "enum": [
                      "16:9",
                      "9:16",
                      "1:1"
                    ]
                  }
                },
                "required": [
                  "op"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "insert"
                  },
                  "asset": {
                    "type": "string",
                    "minLength": 1
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "settings": {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "number",
                        "minimum": 0
                      },
                      "end": {
                        "type": "number",
                        "minimum": 0.04
                      },
                      "speed": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 2
                      },
                      "zoom": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 2
                      },
                      "brightness": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 1.5
                      },
                      "contrast": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 1.5
                      },
                      "saturation": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 2
                      },
                      "volume": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "title": {
                        "type": "string",
                        "maxLength": 160
                      },
                      "subtitle": {
                        "type": "string",
                        "maxLength": 180
                      },
                      "titleSize": {
                        "type": "number",
                        "minimum": 0.4,
                        "maximum": 1.8
                      },
                      "fadeIn": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 60
                      },
                      "fadeOut": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 60
                      },
                      "motion": {
                        "enum": [
                          "",
                          "push",
                          "settle",
                          "detail"
                        ],
                        "description": "Native camera-motion preset. Empty means static."
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "op",
                  "asset"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "update"
                  },
                  "clip": {
                    "type": "string",
                    "minLength": 1
                  },
                  "settings": {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "number",
                        "minimum": 0
                      },
                      "end": {
                        "type": "number",
                        "minimum": 0.04
                      },
                      "speed": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 2
                      },
                      "zoom": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 2
                      },
                      "brightness": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 1.5
                      },
                      "contrast": {
                        "type": "number",
                        "minimum": 0.5,
                        "maximum": 1.5
                      },
                      "saturation": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 2
                      },
                      "volume": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "title": {
                        "type": "string",
                        "maxLength": 160
                      },
                      "subtitle": {
                        "type": "string",
                        "maxLength": 180
                      },
                      "titleSize": {
                        "type": "number",
                        "minimum": 0.4,
                        "maximum": 1.8
                      },
                      "fadeIn": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 60
                      },
                      "fadeOut": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 60
                      },
                      "motion": {
                        "enum": [
                          "",
                          "push",
                          "settle",
                          "detail"
                        ],
                        "description": "Native camera-motion preset. Empty means static."
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "op",
                  "clip",
                  "settings"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "remove"
                  },
                  "clip": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "op",
                  "clip"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "move"
                  },
                  "clip": {
                    "type": "string",
                    "minLength": 1
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "op",
                  "clip",
                  "index"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "split"
                  },
                  "clip": {
                    "type": "string",
                    "minLength": 1
                  },
                  "at": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Seconds from the beginning of this clip on the timeline, after speed adjustment."
                  }
                },
                "required": [
                  "op",
                  "clip",
                  "at"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "soundtrack"
                  },
                  "asset": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "start": {
                    "type": "number",
                    "minimum": 0
                  },
                  "offset": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "op",
                  "asset"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "marker"
                  },
                  "time": {
                    "type": "number",
                    "minimum": 0
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "op",
                  "time",
                  "name"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "remove_marker"
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "op",
                  "id"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "revision",
        "operations"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "preview_frame",
    "description": "Seek the desktop playhead and return its composited JPEG, including titles, grading and fades.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "seconds"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "export_video",
    "description": "Start a background MP4 export of the inspected revision. Poll export_status with the returned ID.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "enum": [
            720,
            1080,
            2160
          ]
        }
      },
      "required": [
        "revision",
        "size"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "export_status",
    "description": "Read export progress or the finished local MP4 path.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  }
]
